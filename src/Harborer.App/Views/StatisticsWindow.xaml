<Window x:Class="Harborer.App.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="980" Height="720" AutomationProperties.Name="Statistics">
  <Window.Resources>
    <DataTemplate x:Key="StatTable">
      <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="210" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
              <TextBlock Grid.Column="1" Text="{Binding Count}" TextAlignment="Right" />
              <TextBlock Grid.Column="2" Text="{Binding Share}" TextAlignment="Right" Foreground="{DynamicResource MutedForeground}" />
              <TextBlock Grid.Column="3" Text="{Binding Bytes}" TextAlignment="Right" />
              <Rectangle Grid.Column="4" Height="10" Width="{Binding BarWidth}" HorizontalAlignment="Left" Margin="8,0,0,0"
                         Fill="{DynamicResource PhaseReceive}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate x:Key="EntryTable">
      <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Id, StringFormat=#{0}}" />
              <TextBlock Grid.Column="1" Text="{Binding Method}" />
              <TextBlock Grid.Column="2" Text="{Binding Value}" TextAlignment="Right" Margin="0,0,10,0" />
              <TextBlock Grid.Column="3" Text="{Binding Url}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14">
      <ItemsControl ItemsSource="{Binding Overview}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Label}" Width="140" Foreground="{DynamicResource MutedForeground}" />
              <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource SectionHeader}" Text="Timeline" />
      <TextBlock Text="{Binding TimelineCaption}" Foreground="{DynamicResource MutedForeground}" />
      <ItemsControl ItemsSource="{Binding Timeline}" Height="170" Margin="0,4,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Width="20" Margin="1,0" VerticalAlignment="Bottom" ToolTip="{Binding ToolTip}" Background="Transparent">
              <Rectangle Height="{Binding Height}" VerticalAlignment="Bottom" Fill="{DynamicResource PhaseWait}" />
              <Rectangle Height="{Binding FailedHeight}" VerticalAlignment="Bottom" Fill="{DynamicResource FailedForeground}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource SectionHeader}" Text="By status class" />
      <ContentControl Content="{Binding ByStatus}" ContentTemplate="{StaticResource StatTable}" />
      <TextBlock Style="{StaticResource SectionHeader}" Text="By MIME category" />
      <ContentControl Content="{Binding ByMime}" ContentTemplate="{StaticResource StatTable}" />
      <TextBlock Style="{StaticResource SectionHeader}" Text="By host" />
      <ContentControl Content="{Binding ByHost}" ContentTemplate="{StaticResource StatTable}" />
      <TextBlock Style="{StaticResource SectionHeader}" Text="Slowest ten" />
      <ContentControl Content="{Binding Slowest}" ContentTemplate="{StaticResource EntryTable}" />
      <TextBlock Style="{StaticResource SectionHeader}" Text="Largest ten" />
      <ContentControl Content="{Binding Largest}" ContentTemplate="{StaticResource EntryTable}" />
    </StackPanel>
  </ScrollViewer>
</Window>
