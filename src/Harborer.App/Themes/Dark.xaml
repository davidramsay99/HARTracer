<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- HARborer semantic colors, dark theme. Control chrome comes from WPF's Fluent theme. -->
  <SolidColorBrush x:Key="Status3xxForeground" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Status4xxForeground" Color="#FFB454" />
  <SolidColorBrush x:Key="Status5xxForeground" Color="#FF7B72" />
  <SolidColorBrush x:Key="FailedForeground" Color="#FF7B72" />
  <SolidColorBrush x:Key="MutedForeground" Color="#A0A0A0" />
  <SolidColorBrush x:Key="EditorForeground" Color="#E4E4E4" />
  <SolidColorBrush x:Key="NoticeBackground" Color="#3D3420" />
  <SolidColorBrush x:Key="NoticeForeground" Color="#F5E6B8" />
  <SolidColorBrush x:Key="DangerBannerBackground" Color="#B3261E" />
  <SolidColorBrush x:Key="DangerBannerForeground" Color="White" />
  <SolidColorBrush x:Key="DiffInsertedBackground" Color="#1F3A24" />
  <SolidColorBrush x:Key="DiffDeletedBackground" Color="#46201E" />
  <SolidColorBrush x:Key="DiffModifiedBackground" Color="#3D3520" />
  <SolidColorBrush x:Key="ChipCheckedBackground" Color="#2B4A66" />
  <SolidColorBrush x:Key="GroupHeaderBackground" Color="#2A2E33" />
  <!-- Waterfall phases: blocked, DNS, connect, TLS, send, wait, receive. -->
  <SolidColorBrush x:Key="PhaseBlocked" Color="#B8B8B8" />
  <SolidColorBrush x:Key="PhaseDns" Color="#2BA39B" />
  <SolidColorBrush x:Key="PhaseConnect" Color="#E3A21A" />
  <SolidColorBrush x:Key="PhaseTls" Color="#9B59B6" />
  <SolidColorBrush x:Key="PhaseSend" Color="#2D7D9A" />
  <SolidColorBrush x:Key="PhaseWait" Color="#2E8B57" />
  <SolidColorBrush x:Key="PhaseReceive" Color="#2F6FD6" />
  <!-- Annotation color marks (row tint). -->
  <SolidColorBrush x:Key="MarkRed" Color="#33E81123" />
  <SolidColorBrush x:Key="MarkOrange" Color="#33F7630C" />
  <SolidColorBrush x:Key="MarkYellow" Color="#44FFB900" />
  <SolidColorBrush x:Key="MarkGreen" Color="#3310893E" />
  <SolidColorBrush x:Key="MarkBlue" Color="#330078D4" />
  <SolidColorBrush x:Key="MarkPurple" Color="#33881798" />
</ResourceDictionary>
