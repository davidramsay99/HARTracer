<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell, views, view models. No network (enforced by BannedSymbols.txt).
       References Harborer.Net only so that the assembly ships beside (or inside) HARborer.exe;
       BannedSymbols.txt forbids naming its types, and RequestEngineLoader loads it on first Send. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <AssemblyName>HARborer</AssemblyName>
    <RootNamespace>Harborer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnforceLocalOnly>true</EnforceLocalOnly>
    <!-- WPF0001: Application.ThemeMode (Fluent light/dark) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborer.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AvalonEdit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Harborer.Core\Harborer.Core.csproj" />
    <ProjectReference Include="..\Harborer.Net\Harborer.Net.csproj" />
  </ItemGroup>
</Project>
