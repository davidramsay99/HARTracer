<UserControl x:Class="HarLens.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HarLens.App.Views"
             xmlns:controls="clr-namespace:HarLens.App.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="WaterfallTemplate">
      <controls:WaterfallBar Entry="{Binding Entry}" AxisStart="{Binding AxisStart}" AxisMilliseconds="{Binding AxisMilliseconds}"
                             Height="18" HorizontalAlignment="Stretch" />
    </DataTemplate>
    <Style x:Key="RowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
      <Setter Property="Background" Value="{Binding ColorMark, Converter={StaticResource ColorMarkBrush}}" />
      <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Url}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding RowState}" Value="3xx">
          <Setter Property="Foreground" Value="{DynamicResource Status3xxForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RowState}" Value="4xx">
          <Setter Property="Foreground" Value="{DynamicResource Status4xxForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RowState}" Value="5xx">
          <Setter Property="Foreground" Value="{DynamicResource Status5xxForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RowState}" Value="failed">
          <Setter Property="Foreground" Value="{DynamicResource FailedForeground}" />
          <Setter Property="FontStyle" Value="Italic" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="RowMenu">
      <MenuItem Header="Copy URL" InputGestureText="Ctrl+C" Command="{Binding CopyUrlCommand}" />
      <MenuItem Header="Copy Request Headers" Command="{Binding CopyRequestHeadersCommand}" />
      <MenuItem Header="Copy Response Headers" Command="{Binding CopyResponseHeadersCommand}" />
      <MenuItem Header="Copy Response Body" Command="{Binding CopyResponseBodyCommand}" />
      <MenuItem Header="Copy As">
        <MenuItem Header="cURL (bash)" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyAsCommand}" CommandParameter="CurlBash" />
        <MenuItem Header="cURL (Windows cmd)" Command="{Binding CopyAsCommand}" CommandParameter="CurlCmd" />
        <MenuItem Header="cURL (PowerShell, curl.exe)" Command="{Binding CopyAsCommand}" CommandParameter="CurlPowerShell" />
        <MenuItem Header="PowerShell Invoke-WebRequest" Command="{Binding CopyAsCommand}" CommandParameter="PowerShellInvokeWebRequest" />
        <MenuItem Header="Raw HTTP" Command="{Binding CopyAsCommand}" CommandParameter="RawHttp" />
      </MenuItem>
      <MenuItem Header="Save Response Body…" Command="{Binding SaveResponseBodyCommand}" />
      <Separator />
      <MenuItem Header="Send to Composer" InputGestureText="Ctrl+R" Command="{Binding SendToComposerCommand}" />
      <MenuItem Header="Compare Two Selected" Command="{Binding CompareCommand}" />
      <MenuItem Header="Statistics for Selection" Command="{Binding StatisticsCommand}" />
      <Separator />
      <MenuItem Header="Comment…" Command="{Binding EditCommentCommand}" />
      <MenuItem Header="Color Mark">
        <MenuItem Header="Red" Command="{Binding SetColorCommand}" CommandParameter="red" />
        <MenuItem Header="Orange" Command="{Binding SetColorCommand}" CommandParameter="orange" />
        <MenuItem Header="Yellow" Command="{Binding SetColorCommand}" CommandParameter="yellow" />
        <MenuItem Header="Green" Command="{Binding SetColorCommand}" CommandParameter="green" />
        <MenuItem Header="Blue" Command="{Binding SetColorCommand}" CommandParameter="blue" />
        <MenuItem Header="Purple" Command="{Binding SetColorCommand}" CommandParameter="purple" />
        <MenuItem Header="None" Command="{Binding SetColorCommand}" CommandParameter="none" />
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <DockPanel>
    <!-- Loading progress -->
    <Border DockPanel.Dock="Top" Padding="8,4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelLoadCommand}" Margin="8,0,0,0" />
        <TextBlock DockPanel.Dock="Left" Text="Loading…" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ProgressBar Value="{Binding LoadProgress}" Maximum="100" Height="6" VerticalAlignment="Center" AutomationProperties.Name="Loading progress" />
      </DockPanel>
    </Border>

    <!-- Warnings and parse failures -->
    <Border DockPanel.Dock="Top" Style="{StaticResource NoticeBorder}" Margin="4,4,4,0"
            Visibility="{Binding Banner, Converter={StaticResource NullToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                Click="OnDismissBanner" AutomationProperties.Name="Dismiss message" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeForeground}" />
      </DockPanel>
    </Border>

    <!-- Filter bar -->
    <Grid DockPanel.Dock="Top" Margin="4,4,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}"
                 AutomationProperties.Name="Filter" KeyDown="OnFilterKeyDown"
                 ToolTip="Filter (Ctrl+L). Example: status-code:5xx -domain:*.cdn.test header:x-cache=TCP_MISS /api\/v2/" />
        <TextBlock Text="Filter  (status-code:5xx  domain:*.contoso.com  -mime-type:image/png  /regex/)" IsHitTestVisible="False"
                   Foreground="{DynamicResource MutedForeground}" Margin="12,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding FilterText, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
      <ComboBox Grid.Column="1" Width="150" Margin="4,0,0,0" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedPreset}" AutomationProperties.Name="Saved filters" ToolTip="Saved filter presets" />
      <Button Grid.Column="2" Content="Save" Margin="4,0,0,0" Command="{Binding SavePresetCommand}" ToolTip="Save the filter as a preset" />
      <Button Grid.Column="3" Content="Delete" Margin="4,0,0,0" Command="{Binding DeletePresetCommand}" ToolTip="Delete the selected preset" />
    </Grid>

    <!-- Quick-toggle chips -->
    <WrapPanel DockPanel.Dock="Top" Margin="4,4,4,2">
      <ToggleButton Style="{StaticResource Chip}" Content="All" IsChecked="{Binding ChipAll}" />
      <ToggleButton Style="{StaticResource Chip}" Content="XHR/Fetch" IsChecked="{Binding ChipFetch}" />
      <ToggleButton Style="{StaticResource Chip}" Content="Doc" IsChecked="{Binding ChipDoc}" />
      <ToggleButton Style="{StaticResource Chip}" Content="JS" IsChecked="{Binding ChipJs}" />
      <ToggleButton Style="{StaticResource Chip}" Content="CSS" IsChecked="{Binding ChipCss}" />
      <ToggleButton Style="{StaticResource Chip}" Content="Img" IsChecked="{Binding ChipImg}" />
      <ToggleButton Style="{StaticResource Chip}" Content="Font" IsChecked="{Binding ChipFont}" />
      <ToggleButton Style="{StaticResource Chip}" Content="Media" IsChecked="{Binding ChipMedia}" />
      <ToggleButton Style="{StaticResource Chip}" Content="WS" IsChecked="{Binding ChipWs}" />
      <ToggleButton Style="{StaticResource Chip}" Content="Other" IsChecked="{Binding ChipOther}" Margin="0,0,14,0" />
      <ToggleButton Style="{StaticResource Chip}" Content="1xx" IsChecked="{Binding Chip1xx}" />
      <ToggleButton Style="{StaticResource Chip}" Content="2xx" IsChecked="{Binding Chip2xx}" />
      <ToggleButton Style="{StaticResource Chip}" Content="3xx" IsChecked="{Binding Chip3xx}" />
      <ToggleButton Style="{StaticResource Chip}" Content="4xx" IsChecked="{Binding Chip4xx}" />
      <ToggleButton Style="{StaticResource Chip}" Content="5xx" IsChecked="{Binding Chip5xx}" />
      <ToggleButton Style="{StaticResource Chip}" Content="Failed" IsChecked="{Binding ChipFailed}" />
      <TextBlock Text="{Binding FilterError}" Foreground="{DynamicResource Status5xxForeground}" Margin="10,0,0,0" VerticalAlignment="Center" />
    </WrapPanel>

    <Grid x:Name="MainGrid">
      <DataGrid x:Name="List" Style="{StaticResource CompactGrid}" RowStyle="{StaticResource RowStyle}"
                SelectedItem="{Binding SelectedRow}" ContextMenu="{StaticResource RowMenu}"
                CanUserReorderColumns="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Item" AutomationProperties.Name="Session list"
                Sorting="OnSorting" SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown"
                ColumnReordered="OnColumnLayoutChanged">
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource GroupHeaderBackground}" Padding="6,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </DataGrid.GroupStyle>
      </DataGrid>
      <GridSplitter x:Name="Splitter" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted"
                    AutomationProperties.Name="Resize list and inspector" />
      <views:InspectorView x:Name="InspectorPane" DataContext="{Binding Inspector}" />
    </Grid>
  </DockPanel>
</UserControl>
