<Window x:Class="HarLens.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find in all entries" Width="860" Height="520" ShowInTaskbar="False"
        AutomationProperties.Name="Find in all entries">
  <DockPanel Margin="10">
    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}"
               AutomationProperties.Name="Search text" />
      <Button Grid.Column="1" Content="Search" IsDefault="True" Command="{Binding SearchCommand}" Margin="6,0,0,0" MinWidth="80" />
      <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0" MinWidth="80"
              IsEnabled="{Binding IsSearching}" />
    </Grid>
    <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,4">
      <CheckBox Content="URL" IsChecked="{Binding InUrl}" Margin="0,0,12,0" />
      <CheckBox Content="Request headers" IsChecked="{Binding InRequestHeaders}" Margin="0,0,12,0" />
      <CheckBox Content="Request body" IsChecked="{Binding InRequestBody}" Margin="0,0,12,0" />
      <CheckBox Content="Response headers" IsChecked="{Binding InResponseHeaders}" Margin="0,0,12,0" />
      <CheckBox Content="Response body" IsChecked="{Binding InResponseBody}" Margin="0,0,24,0" />
      <CheckBox Content="Case sensitive" IsChecked="{Binding CaseSensitive}" Margin="0,0,12,0" />
      <CheckBox Content="Regex" IsChecked="{Binding UseRegex}" Margin="0,0,12,0" />
      <CheckBox Content="All tabs" IsChecked="{Binding AllTabs}" />
    </WrapPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <ProgressBar DockPanel.Dock="Right" Width="160" Height="6" Value="{Binding Progress}" Maximum="100"
                   Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" />
    </DockPanel>
    <DataGrid Style="{StaticResource CompactGrid}" ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}" SelectionMode="Single"
              AutomationProperties.Name="Search results">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Entry.Id}" Width="56" />
        <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="190" />
        <DataGridTextColumn Header="Match" Binding="{Binding Snippet}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
