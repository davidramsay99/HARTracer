<Window x:Class="HarLens.App.Views.SanitizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export sanitized HAR" Width="1000" Height="720" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Export sanitized HAR">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
      <Run Text="Writes a new file. The source file is never modified, no temporary file is written, and bodies are decoded in memory. Scope:" />
      <Run Text="{Binding Scope, Mode=OneWay}" FontWeight="SemiBold" />
    </TextBlock>
    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Style="{StaticResource SectionHeader}" Text="Headers" />
        <TextBlock Text="{Binding DefaultHeaders, StringFormat=Always: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
        <TextBlock Text="More header names (one per line):" Margin="0,4,0,2" />
        <TextBox Text="{Binding ExtraHeaders}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extra header names" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <TextBlock Style="{StaticResource SectionHeader}" Text="Query, form and JSON parameters" />
        <TextBlock Text="{Binding DefaultParameters, StringFormat=Always: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
        <TextBlock Text="More parameter names (one per line):" Margin="0,4,0,2" />
        <TextBox Text="{Binding ExtraParameters}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extra parameter names" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource SectionHeader}" Text="Patterns and bodies" />
        <CheckBox Content="JSON Web Tokens" IsChecked="{Binding RedactJwt}" />
        <CheckBox Content="Bearer and Basic credentials" IsChecked="{Binding RedactBearer}" />
        <CheckBox Content="Parameter names as JSON properties" IsChecked="{Binding RedactJsonProperties}" />
        <CheckBox Content="Remove every other copy of removed values" IsChecked="{Binding SweepKnownValues}" />
        <TextBlock Text="Regular expressions (one per line; a group named 'secret' limits the redaction):" TextWrapping="Wrap" Margin="0,4,0,2" />
        <TextBox Text="{Binding Patterns}" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto" Style="{StaticResource MonoTextBox}"
                 AutomationProperties.Name="Redaction patterns" />
        <CheckBox Content="Drop all response bodies" IsChecked="{Binding DropAllResponseBodies}" Margin="0,4,0,0" />
        <TextBlock Text="Drop bodies of these MIME types (wildcards, for example image/*):" TextWrapping="Wrap" Margin="0,2,0,2" />
        <TextBox Text="{Binding DropMimeTypes}" AutomationProperties.Name="MIME types whose bodies are dropped" />
        <CheckBox Content="Hash values (stable salted SHA-256) instead of removing them" IsChecked="{Binding HashValues}" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Preview" Command="{Binding PreviewCommand}" MinWidth="90" Margin="0,0,6,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <Button Content="Export…" Command="{Binding ExportCommand}" MinWidth="90" Margin="0,0,6,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" Margin="0,0,6,0" IsEnabled="{Binding IsBusy}" />
        <Button Content="Close" IsCancel="True" MinWidth="80" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Right" Width="140" Height="6" Margin="0,0,10,0" Value="{Binding Progress}" Maximum="100"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
    <DataGrid Style="{StaticResource CompactGrid}" ItemsSource="{Binding Redactions}" Margin="0,10,0,0" AutomationProperties.Name="Redaction preview">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding EntryId}" Width="56" />
        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
        <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="160" />
        <DataGridTextColumn Header="Original (masked)" Binding="{Binding MaskedOriginal}" Width="140" />
        <DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="160" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
