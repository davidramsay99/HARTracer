<Project>
  <!-- Shared settings for every project. See DECISIONS.md for the reasoning behind each. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- CI and the documented build use locked mode; local edits may refresh the lock file. -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <Company>HarLens</Company>
    <Product>HarLens</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 the HarLens authors</Copyright>
  </PropertyGroup>

  <!-- Section 3.1: projects that must not touch the network opt in with EnforceLocalOnly=true. -->
  <ItemGroup Condition="'$(EnforceLocalOnly)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/BannedSymbols.txt" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EnforceLocalOnly)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030;RS0031;RS0035</WarningsAsErrors>
  </PropertyGroup>
</Project>
