<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI smoke tests: create the real windows and view models on an STA thread and drive them with fixtures.
       Windows only (WPF); on other systems the project builds but is not treated as a test project. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(OS)' == 'Windows_NT'">true</IsTestProject>
    <IsTestProject Condition="'$(OS)' != 'Windows_NT'">false</IsTestProject>
    <RootNamespace>Harborer.App.Tests</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Harborer.App\Harborer.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\**\*" Exclude="..\fixtures\generated\**" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
