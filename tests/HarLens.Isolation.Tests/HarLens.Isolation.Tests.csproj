<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPEC 3.1 / 12.2 items 2 and 3. Runs in its own test host process so that no other test
       loads HarLens.Net first. References HarLens.Net so the DLL is present beside the tests:
       the assertion proves it is not loaded, not merely absent. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HarLens.Isolation.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HarLens.Core\HarLens.Core.csproj" />
    <ProjectReference Include="..\..\src\HarLens.Net\HarLens.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\**\*" Exclude="..\fixtures\generated\**" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
